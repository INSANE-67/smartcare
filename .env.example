# SmartCare — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
#
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE
# These are safe to expose to the browser (anon key is public by design).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE SERVICE ROLE
# WARNING: This key bypasses Row Level Security.
# NEVER expose this to the browser. Use only in server-side code.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AI (server-side only — never expose to the browser)
# ─────────────────────────────────────────────────────────────────────────────
# AI_API_KEY=
# AI_MODEL=
