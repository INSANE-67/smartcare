# SmartCare — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
#
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — PUBLIC
# These are safe to expose to the browser (publishable/anon key is public
# by design — Row Level Security is the access-control layer).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — SERVICE ROLE (SERVER-ONLY)
#
# WARNING: This key BYPASSES Row Level Security entirely.
# NEVER prefix this with NEXT_PUBLIC_ — it must NEVER reach the browser.
# Used only for:
#   - Writing to audit_logs
#   - Admin role promotion (UPDATE profiles SET role)
#   - System-level operations that require bypassing RLS
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
